{
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:5174" ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-health": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/identity/health" },
        "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
      },
      "identity-register-tenant": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/identity/tenants", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
      },
      "identity-login": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/identity/auth/login", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
      },
      "identity-refresh": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/identity/auth/refresh", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
      },
      "identity": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
      },
      "catalog-health": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/catalog/health" },
        "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
      },
      "catalog": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
      },
      "core-health": {
        "ClusterId": "core",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/core/health" },
        "Transforms": [ { "PathRemovePrefix": "/api/core" } ]
      },
      "core": {
        "ClusterId": "core",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/core/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/core" } ]
      },
      "channel-health": {
        "ClusterId": "channel",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/channel/health" },
        "Transforms": [ { "PathRemovePrefix": "/api/channel" } ]
      },
      "channel-webhooks": {
        "ClusterId": "channel",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/channel/webhooks/{channel}", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/channel" } ]
      },
      "channel": {
        "ClusterId": "channel",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/channel/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/channel" } ]
      },
      "insights-health": {
        "ClusterId": "insights",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/insights/health" },
        "Transforms": [ { "PathRemovePrefix": "/api/insights" } ]
      },
      "insights": {
        "ClusterId": "insights",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/insights/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/insights" } ]
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "default": { "Address": "http://identity:8080" } } },
      "catalog": { "Destinations": { "default": { "Address": "http://catalog:8080" } } },
      "core": { "Destinations": { "default": { "Address": "http://core:8080" } } },
      "channel": { "Destinations": { "default": { "Address": "http://channel:8080" } } },
      "insights": { "Destinations": { "default": { "Address": "http://insights:8080" } } }
    }
  }
}
