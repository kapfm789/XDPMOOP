# Giá trị mẫu cho máy dev. Không có deploy/.env thì Compose dùng đúng các giá trị này.
# Muốn đổi: sao chép thành deploy/.env (đã nằm trong .gitignore). Không đưa giá trị thật vào repo.

POSTGRES_USER=oism
POSTGRES_PASSWORD=oism
# Đổi khi máy đã có PostgreSQL chiếm cổng 5432.
POSTGRES_PORT=5432

RABBITMQ_USER=oism
RABBITMQ_PASSWORD=oism

# Cặp khóa RSA của JWT, mỗi khóa là phần thân của file PEM viết trên một dòng (bỏ dòng BEGIN/END).
# JWT_PRIVATE_KEY: PKCS#8, chỉ identity nhận, dùng để ký. Để trống thì đăng nhập trả 500.
# JWT_PUBLIC_KEY: SubjectPublicKeyInfo, gateway và mọi service nhận, dùng để kiểm. Để trống thì mọi endpoint
# cần đăng nhập trả 401.
# Sinh một cặp cho máy mình rồi dán hai dòng in ra vào deploy/.env (Git Bash có sẵn openssl):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#   echo "JWT_PRIVATE_KEY=$(grep -v -- ----- jwt.pem | tr -d '[:space:]')"
#   echo "JWT_PUBLIC_KEY=$(openssl pkey -in jwt.pem -pubout | grep -v -- ----- | tr -d '[:space:]')"
#   rm jwt.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
