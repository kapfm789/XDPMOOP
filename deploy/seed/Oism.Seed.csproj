<Project Sdk="Microsoft.NET.Sdk">
  <!-- Seed data của gói demo (W4-09): docs/plans/deploy.md. Cách chạy ở README.md cùng thư mục.
       Nằm ngoài backend/ nên không nhận Directory.Build.props và Directory.Packages.props của backend. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Oism.Seed</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cùng phiên bản với backend/Directory.Packages.props. -->
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Hợp đồng OrderConfirmed dùng chung với core và insights, để lịch sử bán phát ra đúng dạng consumer đọc. -->
    <ProjectReference Include="../../backend/shared/Oism.Contracts/Oism.Contracts.csproj" />
  </ItemGroup>
</Project>
